# 環境變數範例檔案
# 複製此檔案為 .env 並填入您的設定

# GitHub Pages 部署設定
# 如果您的 repository 名稱不是 lottery-system，請修改此值
VITE_BASE_URL=/lottery-system/

# Google Sheets 預設網址（可選）
# VITE_DEFAULT_SHEET_URL=https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit

# 自動更新間隔時間（毫秒，預設 5000 = 5秒）
# VITE_AUTO_UPDATE_INTERVAL=5000
