# 環境變數範例檔案
# 複製此檔案為 .env 並填入您的設定

# 部署 Base Path 設定
# 自訂網域（如 luckydraw.chenaho.com）使用: /
# GitHub Pages 預設網域（如 username.github.io/lottery-system/）使用: /lottery-system/
VITE_BASE_PATH=/

# Google Sheets 預設網址（可選）
# VITE_DEFAULT_SHEET_URL=https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit

# 自動更新間隔時間（毫秒，預設 5000 = 5秒）
# VITE_AUTO_UPDATE_INTERVAL=5000
